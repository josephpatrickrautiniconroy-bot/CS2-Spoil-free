{
  "rules": {
    "votes": {
      ".read": true,
      "$match": {
        ".validate": "$match.matches(/^[A-Za-z0-9_-]{1,64}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2 || newData.val() === 3)"
        }
      }
    }
  }
}
